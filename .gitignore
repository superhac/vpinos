# Personal working notes -- never committed
/notes/

# Build output (see notes/vpinos.md's Directory reference)
/dist/

# live-build's own build-time workspace -- regenerated by every `lb
# build`, wiped by `lb clean`, never part of the shipped image or
# meant to be committed
/chroot/
/binary/
/cache/
/.build/
/local/

# Stray build byproducts if a build is interrupted before its
# `dist/`-move step runs
/live-image-amd64.*
/chroot.*
/binary.*
