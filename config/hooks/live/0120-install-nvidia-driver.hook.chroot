#!/bin/sh
set -e

# amd64 only -- real CI failure, not a guess: this hook ran
# unconditionally on the arm64 matrix leg too (see
# .github/workflows/build-iso.yml) and broke the whole arm64 build,
# `E: Package 'linux-headers-amd64' has no installation candidate`,
# the moment it hit the hardcoded amd64 package names below. NVIDIA
# does have an arm64 driver, but only for Jetson/Tegra SoCs via a
# completely different packaging stack outside Debian's own archives --
# irrelevant to this project's desktop/cabinet GPU scope, so this
# skips outright on anything but amd64 rather than trying to make the
# rest of this hook architecture-generic.
[ "$(dpkg --print-architecture)" = "amd64" ] || exit 0

# Precompiles the NVIDIA proprietary driver's kernel module
# (nvidia-kernel-dkms, the actual DKMS source package `nvidia-driver`
# depends on -- confirmed via packages.debian.org, trixie's
# non-free-firmware component, already enabled by this image's
# --archive-areas) against whatever kernel is already installed in
# this chroot by this point (linux-image-amd64, from the main package
# list, installed well before any hook runs). DKMS just builds against
# whatever kernel headers are present -- nothing here is pinned to a
# specific kernel version, so this automatically tracks whatever this
# image ships, including future trixie-backports kernel bumps, with no
# changes needed in this file.
#
# Pulls nvidia-graphics-drivers from sid specifically (see
# config/archives/vpinos-sid.list/.pref) -- confirmed via a real failed
# build that neither trixie's (550.163.01-2) nor trixie-backports'
# (550.163.01-4~bpo13+1) nvidia-kernel-dkms compiles against this
# image's 7.1.13 kernel (a kernel VMA-locking refactor broke the
# build: `VMA_LOCK_OFFSET`/`__is_vma_write_locked` no longer match).
# Only sid's 550.163.01-5.1 has the fix, confirmed directly in its
# real changelog. Nothing below needs to reference sid explicitly --
# the pin file alone makes apt resolve nvidia-graphics-drivers'
# packages from sid automatically, same pattern as the plain `apt-get
# install hyprland` in the main package list relying on
# vpinos-backports.pref rather than an explicit `/trixie-backports`
# suffix.
#
# Opt-in only -- see vpinos-menu.sh's "GPU Driver" option and
# vpinos-gpu-driver.sh. The open-source Mesa/NVK driver (this image's
# existing default, works via the broad firmware-linux install) stays
# the default; this is precompiled and shipped but not loaded unless
# explicitly selected, since Hyprland/Wayland compatibility with the
# proprietary driver hasn't been independently verified by this
# project on real NVIDIA hardware yet -- see notes/vpinos.md step 5.
#
# build-essential/linux-headers-amd64/dkms are needed ONLY to compile
# the module -- stripped afterward entirely, matching this image's
# existing policy of never shipping a compiler (see e.g. vpxconfig/
# vpinball's own package comments: no toolchain needed since they ship
# as prebuilt .debs). What's actually kept: the compiled module itself
# and nvidia-driver's userspace libraries (libnvidia-*, Vulkan/EGL
# ICDs, nvidia-smi, Xorg driver) -- not the umbrella `nvidia-driver`
# metapackage, not `nvidia-kernel-dkms`, not `dkms`, not the compiler.
#
# Two earlier approaches were tried and failed on a REAL build before
# landing on this one -- recorded here so neither gets retried:
#   1. Keep `dkms` installed (it's "just a script framework"). Wrong:
#      `dkms` genuinely Depends on gcc/cpp (it needs a real compiler to
#      do its job) -- autoremove correctly refused to touch them,
#      leaving ~164MB of dead-weight compiler for a dkms that, by
#      design, was never going to be used again anyway (see the
#      kernel-upgrade trade-off note below).
#   2. `dpkg --purge --force-depends dkms` alone, leaving
#      `nvidia-kernel-dkms`'s now-unsatisfied dependency on it as
#      "cosmetic" breakage. Wrong: apt-get refuses to run ANY further
#      command, including a plain `autoremove`, the instant it sees a
#      broken dependency anywhere on the system ("E: Unmet
#      dependencies") -- this isn't cosmetic, it blocks every
#      subsequent hook's own apt-get calls too.
#
# The approach that actually works: back up the already-compiled
# module files, then purge the *whole* DKMS chain in one atomic
# transaction -- the umbrella `nvidia-driver` metapackage,
# `nvidia-kernel-dkms` (whose own removal script calls `dkms remove`,
# which is why the backup happens first), `dkms`, and the compiler --
# all together, so nothing is ever left depending on something that's
# gone. Then restore the backed-up module files directly and
# regenerate `depmod`'s database so `modprobe nvidia` can find them --
# modprobe only needs the .ko(.xz) file present under
# /lib/modules/<kver>/ and depmod's module-alias database kept current;
# neither depends on dkms's own bookkeeping surviving.
apt-get install -y linux-headers-amd64 build-essential dkms nvidia-driver

kver=$(ls /lib/modules)
backup_dir=/root/nvidia-module-backup
mkdir -p "$backup_dir"
cp -a "/lib/modules/$kver/updates/dkms/." "$backup_dir/"

# Protect every real userspace NVIDIA/CUDA package from the upcoming
# autoremove -- broad name match rather than a hand-maintained list,
# so nothing real (libnvidia-*, the Xorg/Vulkan/EGL drivers,
# nvidia-smi, firmware-nvidia-gsp, ...) gets swept away just because it
# was originally pulled in as a dependency of the metapackage this
# removes next. Matches nothing in the actual toolchain (gcc-14,
# cpp-14, linux-headers-*-common), which is exactly what should still
# get cleaned up.
apt-mark manual $(dpkg-query -W -f='${Package}\n' | grep -iE 'nvidia|cuda')

# Known trade-off of stripping the toolchain here rather than keeping
# it on the installed system: DKMS's whole mechanism is rebuilding the
# module automatically whenever a NEW kernel is installed (a postinst
# hook on the kernel package) -- without a compiler/headers present on
# the installed system, that automatic rebuild can't happen. A kernel
# upgrade (e.g. a future trixie-backports bump) would leave the
# NVIDIA module built only for the OLD kernel; vpinos-gpu-driver.sh's
# `modprobe nvidia` would then fail (logged, not fatal -- see that
# script) until this hook's build step is effectively redone, i.e. the
# ISO is rebuilt. Not solved here -- flagging it rather than silently
# shipping a driver that can go stale after an unrelated kernel update.
apt-get purge -y nvidia-driver nvidia-kernel-dkms dkms build-essential linux-headers-amd64
apt-get autoremove -y

# `apt-get autoremove` alone, even run twice, does NOT fully sweep this
# specific cluster -- confirmed directly against the real chroot left
# over from an earlier build of this hook: it correctly caught
# g++/libstdc++-14-dev, but left gcc-14/cpp-14/dpkg-dev/
# linux-headers-*-common genuinely orphaned (nothing in the installed
# package set depends on any of them -- verified with `apt-cache
# rdepends --installed` and a real `apt-get remove --purge --dry-run`
# against that chroot) yet unremoved; this is a known real limitation
# of autoremove's garbage-collection pass on larger multi-level
# clusters, not something unique to this hook. Naming the stragglers
# explicitly, confirmed to cascade cleanly (apt pulls in every
# remaining gcc-14-for-host/cpp-14-for-host/-x86-64-linux-gnu/etc.
# sub-package on its own once these three are named) -- gcc-14/cpp-14
# hardcode trixie's current default GCC version; if a future Debian
# point release ever bumps it, worst case is this cluster stops
# matching and the ~164MB comes back, not a build failure.
apt-get purge -y gcc-14-x86-64-linux-gnu cpp-14-x86-64-linux-gnu dpkg-dev
apt-get autoremove -y

mkdir -p "/lib/modules/$kver/updates/dkms"
cp -a "$backup_dir/." "/lib/modules/$kver/updates/dkms/"
rm -rf "$backup_dir"
depmod -a "$kver"

# Real regression, confirmed on a real boot (not theoretical): with
# nvidia-driver installed, `glx-alternative-nvidia`'s postinst
# registers /etc/modules-load.d/nvidia.conf as an alternatives-managed
# symlink (two layers deep: glx--nvidia-load.conf ->
# nvidia--nvidia-load.conf -> /etc/nvidia/nvidia-<ver>/nvidia-load.conf,
# whose actual content is the single line "nvidia-drm") --
# unconditionally, regardless of /etc/vpinos/gpu-driver. That makes
# systemd-modules-load.service try to `modprobe nvidia-drm` on *every*
# boot, on *any* hardware, completely bypassing this feature's own
# opt-in toggle (vpinos-gpu-driver.sh) -- on a machine without an
# NVIDIA GPU this showed up as a real boot failure: "NVRM: No NVIDIA
# GPU found", nvlink registering and immediately unregistering, and
# systemd-modules-load.service reporting [FAILED]. Deleting just the
# symlink (not touching the alternatives system's own bookkeeping, and
# not the deeper files it points to, which vpinos-gpu-driver.sh's own
# explicit `modprobe` calls still use normally) is enough --
# /etc/modules-load.d/ is systemd's own "auto-load these at boot"
# directory, read by nothing else, so removing one file from it has no
# effect beyond stopping this specific unconditional auto-load.
rm -f /etc/modules-load.d/nvidia.conf

# Same real-boot regression, same root pattern, different package:
# nvidia-persistenced's own postinst enables
# nvidia-persistenced.service (WantedBy=multi-user.target)
# unconditionally too -- confirmed via a real boot screenshot:
# "[FAILED] Failed to start nvidia-persistenced.service". Its own
# shipped unit file literally calls itself "a sample systemd service
# file" -- it exists purely to avoid GPU re-init overhead between
# client processes on compute workloads, not something vpinball/
# Hyprland need to actually render anything, and it can't do anything
# useful without the nvidia kernel module loaded (which, by design,
# only happens when "nvidia" mode is explicitly selected). Disabled
# outright for the same opt-in reasoning as the modules-load.d fix
# above, rather than something more involved like a ConditionPathExists
# drop-in keyed to /etc/vpinos/gpu-driver -- nothing in this project
# depends on persistence-daemon behavior even when nvidia mode *is*
# selected.
systemctl disable nvidia-persistenced.service

# Real multi-monitor regression, confirmed on real NVIDIA hardware
# (live session -- fresh boot every time, no persisted state involved):
# the text-mode vpinos-menu couldn't even display with more than one
# monitor connected. Root-caused by directly extracting the real built
# initrd (`unmkinitramfs`) rather than guessing: nvidia-blacklists-
# nouveau.conf's own comment says it needs `update-initramfs -u` to
# take effect, and installing nvidia-driver above does trigger exactly
# that -- confirmed the blacklist really is baked into the initramfs,
# right alongside nouveau.ko.xz itself. That matters because
# vpinos-menu runs on the plain text console, before launch.sh/
# vpinos-gpu-driver.sh ever execute -- with nouveau blacklisted at the
# *initramfs* stage (not just the real root's runtime modprobe.d, which
# is the only place vpinos-gpu-driver.sh's own bypass-by-exact-name
# logic can reach), nothing auto-loads nouveau's real KMS driver for
# the early console anymore, falling back to a generic single-output
# framebuffer driver that apparently can't cope with multiple connected
# monitors.
#
# First fix tried, confirmed WRONG on a real build, not just in
# theory: hide the blacklist, regenerate, restore it afterward --
# reasoning being "only the initramfs needs to not see it, the real
# root should keep it". Didn't work: live-build's own internal
# `lb chroot_hacks` stage runs *after every hook in this project*,
# including 0200-enable-kiosk (the last one), and does its own kernel-
# package cleanup there (removing a stale duplicate linux-image-amd64
# version) which triggers yet another automatic update-initramfs --
# confirmed directly in the build log (`lb chroot_hacks` / "Del
# linux-image-amd64 7.1.8-1~bpo13+1" / "update-initramfs: Generating"
# all appearing together, well after this hook had already restored
# the file). There's no hook point after chroot_hacks to intervene
# again, so "restore it before this hook ends" was never going to
# survive to the actual final initramfs.
#
# Real fix: don't restore it at all -- remove the blacklist
# permanently, for both the initramfs and the real root. Whatever
# regeneration ends up being the final one (this one, or
# chroot_hacks's later one) will be correct either way, since the
# source file is simply gone by then. The real-root protection this
# gives up (stopping nouveau from re-auto-loading while "nvidia" mode
# is active) was always a secondary nicety, not load-bearing:
# vpinos-gpu-driver.sh already explicitly `modprobe -r nouveau`s on
# *every* launch.sh invocation regardless, and this is static GPU
# hardware in a kiosk, not something that hot-replugs mid-session to
# actually trigger a stray re-auto-load in practice.
rm -f /etc/modprobe.d/nvidia-blacklists-nouveau.conf

# Confirmed via a real hardware test that the fix above, while
# genuinely correct (verified directly against the tester's own real
# initramfs listing: nvidia-blacklists-nouveau.conf really is gone),
# did NOT fix the actual symptom -- same multi-monitor failure on
# 1.0.20. The real mechanism was never the blacklist alone. Found by
# actually reading the content of a THIRD nvidia modprobe.d file,
# /etc/modprobe.d/nvidia.conf (resolves, through the same alternatives
# chain as everything else here, to
# /etc/nvidia/nvidia-<ver>/nvidia-modprobe.conf), which this hook had
# never actually looked inside before. It ends with wildcard PCI
# aliases -- vendor 10DE (NVIDIA) matched against any display/3D
# controller class, explicitly commented "sets higher precedence" --
# that redirect the kernel's own udev hardware auto-detection to load
# `nvidia` (itself redirected to the real `nvidia-current` module by an
# `install nvidia ...` line earlier in the same file) the moment it
# sees *any* NVIDIA GPU. This is completely independent of nouveau's
# blacklist and of /etc/vpinos/gpu-driver -- it fires at early boot,
# before vpinos-gpu-driver.sh ever runs, on every boot, regardless of
# mode. Since `nvidia` alone (without `nvidia-drm modeset=1`, which
# only vpinos-gpu-driver.sh applies, later) does no actual
# modesetting, the console was ending up with neither driver correctly
# serving KMS either way -- matching the symptom exactly.
#
# Can't touch nvidia.conf itself: its `install nvidia modprobe -i
# nvidia-current ...` line is what lets vpinos-gpu-driver.sh's own
# plain `modprobe nvidia` resolve to the real module at all (there is
# no file literally named nvidia.ko, only nvidia-current.ko). Adding a
# separate, independently-owned blacklist instead -- same proven
# mechanism as nouveau's own blacklist earlier in this hook: `blacklist
# nvidia` only blocks *automatic* alias-based loading (exactly this PCI
# auto-detection path), not an explicit `modprobe nvidia` by exact
# name, which is exactly what vpinos-gpu-driver.sh still does. Unlike
# the nouveau blacklist, this one is deliberately kept in the
# initramfs too (not hidden-then-restored) -- the goal here is the
# opposite: nvidia should never auto-load at any boot stage, on any
# hardware, unless "nvidia" mode is explicitly selected.
echo "blacklist nvidia" > /etc/modprobe.d/vpinos-nvidia-no-autoload.conf

update-initramfs -u -k all
