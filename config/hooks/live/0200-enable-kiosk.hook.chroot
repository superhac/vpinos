#!/bin/sh
set -e

# launch.sh is run as root via `sudo` (installer menu option, passwordless
# per /etc/sudoers.d/vpinos), so it must be root-owned and NOT writable by
# the kiosk user or group -- otherwise `vpinos` could rewrite it and gain
# root. includes.chroot doesn't set ownership/mode reliably, so set both here.
chown root:root /usr/local/bin/launch.sh
chmod 0755 /usr/local/bin/launch.sh
chmod +x /opt/vpinball/vpinos-menu.sh
ln -sf /opt/vpinball/vpinos-menu.sh /usr/local/bin/vpinos-menu
systemctl set-default multi-user.target
systemctl enable seatd.service
systemctl enable NetworkManager.service
systemctl enable vpinos-hosts.service

# includes.chroot doesn't reliably give files the right ownership/mode:
# mode comes through as-is from the (unprivileged) build host, and
# ownership is inconsistent -- most files land root:root, but
# /etc/os-release was confirmed to come through as the build host's uid,
# which is `vpinos` inside the image (i.e. writable by the kiosk user).
# So anything where it matters is set explicitly here rather than trusted.
#
# sudoers.d files are silently ignored by sudo unless they're exactly
# root:root 0440.
chown root:root /etc/sudoers.d/vpinos
chmod 0440 /etc/sudoers.d/vpinos

chown root:root /etc/os-release
chmod 0644 /etc/os-release

# Root-executed systemd drop-in (ssh host key generation): must not be
# writable by the kiosk user.
chown -R root:root /etc/systemd/system/ssh.service.d
chmod 0755 /etc/systemd/system/ssh.service.d
chmod 0644 /etc/systemd/system/ssh.service.d/vpinos-hostkeys.conf

# vpinball/vpinfe/Chrome now run as `vpinos` (non-root), but launch.sh/
# vpinos-menu.sh write to these via `>>`, and /var/log is root:root
# 0755 -- a non-root process can only append to a file that already
# exists and is writable by it, not create a new one there. Root
# (the installer, still sudo'd) can always write regardless of
# ownership, so owning these by vpinos works for both.
touch /var/log/vpinos-launch.log /var/log/vpinos-weston.log /var/log/vpinos-menu.log /var/log/vpinos-vpxconfig.log
chown vpinos:vpinos /var/log/vpinos-launch.log /var/log/vpinos-weston.log /var/log/vpinos-menu.log /var/log/vpinos-vpxconfig.log

# No systemd service for weston itself -- boot goes to a normal console.
# Run `vpinos-menu` by hand to bring up the (crude, placeholder) menu;
# picking its one option runs launch.sh, which execs weston directly
# (inheriting the caller's tty/session) and launches vpinball as its
# client once the Wayland socket is up.
