# Prefer trixie-backports for the packages needed to run current GPUs
# (AMD RDNA4 e.g. RX 9060 XT needs a 6.14+ kernel, a recent Mesa for RADV,
# and recent AMD GPU firmware -- none of which trixie ships). Backports are
# NotAutomatic (priority 100) by default, so without this file nothing
# would ever be installed from them. `src:` pins every binary package
# built from that source package, so related packages stay in step.
#
# Plain .pref (not .pref.chroot): live-build keeps it in the final image,
# so installed systems keep following backports for these packages on
# `apt upgrade`. Everything not listed here stays on trixie.
Package: src:linux src:linux-signed-amd64 src:mesa src:firmware-nonfree
Pin: release n=trixie-backports
Pin-Priority: 900

# Hyprland isn't packaged in plain trixie at all -- only trixie-backports
# has it (0.55.2, confirmed). Needs a newer libxkbcommon0 than trixie
# ships too (>= 1.12.3; trixie has 1.7.0), which is also backports-only,
# so it needs its own pin -- without this, apt's solver won't pull a
# backports-only dependency in automatically even when the package that
# needs it is itself pinned (confirmed directly: `apt-get install
# hyprland/trixie-backports` alone left libxkbcommon0 held at 1.7.0 and
# failed to resolve; only resolved once libxkbcommon0 was pinned too).
Package: src:hyprland src:libxkbcommon
Pin: release n=trixie-backports
Pin-Priority: 900
